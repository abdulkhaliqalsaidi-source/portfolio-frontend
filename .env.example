# Nuxt 4 Production Environment Variables
PORT=3000
NODE_ENV=production

# Public canonical URL for your website (used in SEO meta tags, OpenGraph, sitemap.xml)
NUXT_PUBLIC_SITE_URL=https://yourdomain.com

# Public API Base URL accessed by browser clients
NUXT_PUBLIC_API_BASE_URL=https://yourdomain.com/api

# Internal API URL accessed by Nuxt Server during SSR (fast internal loopback)
NUXT_API_SERVER_URL=http://127.0.0.1:8000/api
